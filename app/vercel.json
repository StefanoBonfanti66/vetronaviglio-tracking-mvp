{
  "crons": [
    {
      "path": "/api/cron/refresh-tracking",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/discover",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "api/cron/refresh-tracking.ts": {
      "includeFiles": "api/lib/**"
    },
    "api/track.ts": {
      "includeFiles": "api/lib/**"
    },
    "api/discover.ts": {
      "includeFiles": "api/lib/**"
    },
    "api/settings/credentials.ts": {
      "includeFiles": "api/lib/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
